@page "/properties/{Id:int}"
@inject IDbContextFactory<PropertyManagerDbContext> DbFactory
@inject TimeProvider Clock
@inject PropertyPhotoService Photos
@inject IOptionsMonitor<FeatureOptions> Features

<PageTitle>@(property?.Name ?? "Property")</PageTitle>

@if (property is null)
{
    <p><em>@(loaded ? "Property not found." : "Loading…")</em></p>
}
else
{
    <p><a href="properties">← Properties</a></p>
    <div class="d-flex flex-wrap gap-4 align-items-start mb-3">
        <div class="@(Features.CurrentValue.PropertyPhotos ? "" : "d-none")">
            @if (property.PhotoKey is not null)
            {
                <a href="properties/@property.Id/photo?v=@photoVersion" target="_blank">
                    <img src="properties/@property.Id/photo?v=@photoVersion" alt="@property.Name" class="rounded border" style="width: 320px; max-height: 240px; object-fit: cover" />
                </a>
            }
            else
            {
                <div class="rounded border bg-body-tertiary d-flex align-items-center justify-content-center text-muted" style="width: 320px; height: 200px">No photo yet</div>
            }
        </div>
        <div class="flex-grow-1" style="min-width: 18rem">
            <h1>@property.Name</h1>
            <p class="text-muted">@property.FullAddress</p>
            <FeatureGate On="Features.CurrentValue.PropertyPhotos" Quiet="true">
            @if (photoStatus is not null) { <div class="alert alert-success py-1 px-2 small">@photoStatus</div> }
            @if (photoError is not null) { <div class="alert alert-warning py-1 px-2 small">@photoError</div> }

            <form method="post" action="properties/@property.Id/photo" enctype="multipart/form-data" data-file-upload data-return-hash="">
                <AntiforgeryToken />
                <label class="form-label small mb-1">Upload a photo of the house</label>
                <div class="d-flex gap-2">
                    <input type="file" name="files" required class="form-control form-control-sm" accept="image/*,.heic" />
                    <button type="submit" class="btn btn-sm btn-primary">Upload</button>
                </div>
                <div class="alert alert-danger small mt-2" data-upload-message hidden></div>
            </form>

            <label class="form-label small mb-1 mt-3">Or use a photo from a web page (like your LLC's website)</label>
            <div class="d-flex gap-2">
                <input class="form-control form-control-sm" placeholder="parkerflatsllc.com" @bind="webAddress" @bind:event="oninput" />
                <button class="btn btn-sm btn-outline-primary text-nowrap" disabled="@(finding || string.IsNullOrWhiteSpace(webAddress))" @onclick="FindPhotosAsync">@(finding ? "Looking…" : "Find photos")</button>
            </div>
            @if (property.PhotoKey is not null)
            {
                <button class="btn btn-link btn-sm p-0 mt-2 link-danger" @onclick="RemovePhotoAsync">Remove photo</button>
            }
            </FeatureGate>
        </div>
    </div>
    @if (webPhotos is not null)
    {
        <div class="border rounded p-2 mb-3 bg-body-tertiary">
            <div class="d-flex justify-content-between mb-2">
                <span class="small">@(webPhotos.Count == 0 ? "No photos found on that page. On the website, right-click the picture, choose Copy Image Address, and paste it above." : $"{webPhotos.Count} picture(s) found. Click the one of {property.Name}:")</span>
                <button class="btn btn-sm btn-link p-0" @onclick="() => webPhotos = null">Close</button>
            </div>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var url in webPhotos)
                {
                    <button class="btn p-0 border rounded overflow-hidden" title="Use this photo" disabled="@finding" @onclick="() => UseWebPhotoAsync(url)">
                        <img src="@url" alt="" loading="lazy" referrerpolicy="no-referrer" style="width: 180px; height: 130px; object-fit: cover" onerror="this.closest('button').style.display='none'" />
                    </button>
                }
            </div>
        </div>
    }

    <h2 class="h4 mt-4">Units</h2>
    <table class="table align-middle">
        <thead>
            <tr><th>Unit</th><th>Tenant</th><th class="text-end">Lease rent</th><th class="text-end">Market rent</th><th>Beds / baths</th><th>Sq ft</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var u in property.Units.OrderBy(u => u.Label))
            {
                var lease = u.ActiveLease(today);
                if (editingUnit?.Id == u.Id)
                {
                    <tr>
                        <td><InputText @bind-Value="editingUnit.Label" class="form-control form-control-sm" style="width:5rem" /></td>
                        <td>@(lease?.TenantNames ?? "Vacant")</td>
                        <td class="text-end">@(lease?.MonthlyRent.ToString("C0"))</td>
                        <td><InputNumber @bind-Value="editingUnit.MarketRent" class="form-control form-control-sm text-end" /></td>
                        <td class="d-flex gap-1">
                            <InputNumber @bind-Value="editingUnit.Bedrooms" class="form-control form-control-sm" placeholder="Beds" />
                            <InputNumber @bind-Value="editingUnit.Bathrooms" class="form-control form-control-sm" placeholder="Baths" />
                        </td>
                        <td><InputNumber @bind-Value="editingUnit.SquareFeet" class="form-control form-control-sm" /></td>
                        <td class="text-nowrap">
                            <button class="btn btn-sm btn-primary" @onclick="SaveUnitAsync">Save</button>
                            <button class="btn btn-sm btn-link" @onclick="() => editingUnit = null">Cancel</button>
                        </td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td>@u.Label</td>
                        <td>@(lease?.TenantNames ?? "Vacant")</td>
                        <td class="text-end">@(lease?.MonthlyRent.ToString("C0"))</td>
                        <td class="text-end">@u.MarketRent.ToString("C0")</td>
                        <td>@(u.Bedrooms is null && u.Bathrooms is null ? "" : $"{u.Bedrooms} bd / {u.Bathrooms} ba")</td>
                        <td>@u.SquareFeet</td>
                        <td><button class="btn btn-sm btn-outline-secondary" @onclick="() => StartEdit(u)">Edit</button></td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <EditForm Model="newUnit" OnValidSubmit="AddUnitAsync" FormName="add-unit" class="row g-2">
        <div class="col-md-2"><InputText @bind-Value="newUnit.Label" class="form-control" placeholder="Unit label" /></div>
        <div class="col-md-2"><InputNumber @bind-Value="newUnit.MarketRent" class="form-control" placeholder="Market rent" /></div>
        <div class="col-md-2"><button type="submit" class="btn btn-outline-primary w-100">Add unit</button></div>
    </EditForm>
    <FormError Message="@error" />

    <h2 class="h4 mt-5">Property details</h2>
    <EditForm Model="property" OnValidSubmit="SavePropertyAsync" FormName="edit-property" class="row g-2">
        <div class="col-md-4"><label class="form-label">Name</label><InputText @bind-Value="property.Name" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Street</label><InputText @bind-Value="property.Street" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">City</label><InputText @bind-Value="property.City" class="form-control" /></div>
        <div class="col-md-1"><label class="form-label">State</label><InputText @bind-Value="property.State" class="form-control" /></div>
        <div class="col-md-1"><label class="form-label">ZIP</label><InputText @bind-Value="property.PostalCode" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">Purchase date</label><InputDate @bind-Value="property.PurchaseDate" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">Purchase price</label><InputNumber @bind-Value="property.PurchasePrice" class="form-control" /></div>
        <div class="col-md-3">
            <label class="form-label" title="The part of the price that was the land, e.g. from the tax assessment's land and building split. Land isn't depreciated.">Land value</label>
            <InputNumber @bind-Value="property.LandValue" class="form-control" placeholder="for depreciation" />
        </div>
        <div class="col-md-3">
            <label class="form-label" title="Closing costs that add to what the building cost: title, recording, legal fees, transfer taxes.">Closing costs added</label>
            <InputNumber @bind-Value="property.BasisAdditions" class="form-control" placeholder="optional" />
        </div>
        <div class="col-md-3">
            <label class="form-label" title="When it was first available to rent, if later than the purchase date.">First rented (if later)</label>
            <InputDate @bind-Value="property.RentalStartDate" class="form-control" />
        </div>
        <div class="col-12"><label class="form-label">Notes</label><InputTextArea @bind-Value="property.Notes" class="form-control" rows="3" /></div>
        <div class="col-12">
            <button type="submit" class="btn btn-primary">Save details</button>
            @if (saved) { <span class="text-success ms-2">Saved.</span> }
        </div>
    </EditForm>

    <h2 class="h4 mt-5" id="depreciation">Depreciation</h2>
    var schedule = PropertyManager.Core.Reports.Depreciation.Schedule(property, today.Year);
    @if (PropertyManager.Core.Reports.Depreciation.BuildingBasis(property) is null)
    {
        <p class="text-muted" style="max-width: 52rem">
            To have the building's depreciation worked out and put on the profit and loss, fill in the <strong>purchase date</strong>,
            <strong>purchase price</strong>, and <strong>land value</strong> above (land isn't depreciated; your tax assessment's land and
            building split is a common way to divide the price). Improvements below are depreciated either way.
        </p>
    }
    <table class="table table-sm align-middle" style="max-width: 64rem">
        <thead>
            <tr><th>Item</th><th>In service</th><th class="text-end">Cost</th><th>Over</th><th class="text-end">@today.Year deduction</th><th class="text-end">Deducted so far</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var line in schedule)
            {
                var asset = property.Assets.FirstOrDefault(a => a.Description == line.Item && a.PlacedInService == line.PlacedInService && line.Item != "Building");
                <tr>
                    <td>@line.Item</td>
                    <td>@line.PlacedInService.ToString("MMM d, yyyy")</td>
                    <td class="text-end">@line.Basis.ToString("C")</td>
                    <td>@line.Life.ShortName()</td>
                    <td class="text-end">@line.ThisYear.ToString("C")</td>
                    <td class="text-end">@line.Accumulated.ToString("C")</td>
                    <td class="text-end">@if (asset is not null) { <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveAssetAsync(asset.Id)">Remove</button> }</td>
                </tr>
            }
            @if (schedule.Count == 0)
            {
                <tr><td colspan="7" class="text-muted">Nothing being depreciated yet.</td></tr>
            }
        </tbody>
    </table>
    <div class="row g-2 align-items-end" style="max-width: 64rem">
        <div class="col-md-4"><label class="form-label small mb-0">Add an improvement or equipment</label><input class="form-control form-control-sm" placeholder="e.g. New roof, Refrigerator" @bind="newAsset.Description" /></div>
        <div class="col-md-2"><label class="form-label small mb-0">In service</label><input type="date" class="form-control form-control-sm" @bind="newAsset.PlacedInService" /></div>
        <div class="col-md-2"><label class="form-label small mb-0">Cost</label><input type="number" step="0.01" class="form-control form-control-sm" @bind="newAsset.Cost" /></div>
        <div class="col-md-3">
            <label class="form-label small mb-0">Deducted over</label>
            <select class="form-select form-select-sm" @bind="newAsset.Life">
                @foreach (var life in Enum.GetValues<AssetLife>().OrderByDescending(l => l)) { <option value="@life">@life.DisplayName()</option> }
            </select>
        </div>
        <div class="col-md-1"><button class="btn btn-sm btn-outline-primary w-100" @onclick="AddAssetAsync">Add</button></div>
    </div>
    <FormError Message="@assetError" />
    <p class="small text-muted mt-2" style="max-width: 64rem">
        Calculated the standard way (IRS Publication 946): the building and anything that's part of it over 27.5 years, appliances and
        carpet over 5, fences and driveways over 15. The yearly amounts go on the <a href="reports">profit and loss</a> automatically.
        A repair or something written off all at once is entered as an expense instead, not here. Not tax advice: if your past
        returns used different figures, use your preparer's schedule.
    </p>
}

@code {
    [Parameter] public int Id { get; set; }

    private Property? property;
    private Unit newUnit = new();
    private Unit? editingUnit;
    private string? error;
    private bool loaded;
    private bool saved;
    private DateOnly today;

    // Set by the photo upload endpoint when it redirects back here.
    [SupplyParameterFromQuery] public string? Photo { get; set; }
    [SupplyParameterFromQuery] public string? PhotoError { get; set; }

    private string? photoStatus;
    private string? photoError;
    private string webAddress = "";
    private bool finding;
    private IReadOnlyList<string>? webPhotos;
    private long photoVersion = DateTime.UtcNow.Ticks;

    protected override void OnInitialized()
    {
        photoStatus = Photo == "updated" ? "Photo saved." : null;
        photoError = PhotoError;
    }

    private async Task FindPhotosAsync()
    {
        finding = true;
        photoError = photoStatus = null;
        try
        {
            webPhotos = await Photos.FindImagesAsync(webAddress);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidDataException or TaskCanceledException)
        {
            photoError = $"Couldn't read that page: {ex.Message}";
        }
        finally
        {
            finding = false;
        }
    }

    private async Task UseWebPhotoAsync(string url)
    {
        finding = true;
        photoError = photoStatus = null;
        try
        {
            await Photos.SetFromUrlAsync(property!.Id, url);
            webPhotos = null;
            photoStatus = "Photo saved.";
            photoVersion = DateTime.UtcNow.Ticks;
            await LoadAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidDataException or TaskCanceledException)
        {
            photoError = $"Couldn't use that picture: {ex.Message}";
        }
        finally
        {
            finding = false;
        }
    }

    private async Task RemovePhotoAsync()
    {
        await Photos.RemoveAsync(property!.Id);
        photoStatus = "Photo removed.";
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        today = DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);
        if (newAsset.PlacedInService == default)
        {
            newAsset.PlacedInService = today;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        property = await db.Properties.AsNoTracking()
            .Include(p => p.Units).ThenInclude(u => u.Leases).ThenInclude(l => l.Tenants)
            .Include(p => p.Assets)
            .FirstOrDefaultAsync(p => p.Id == Id);
        loaded = true;
    }

    private void StartEdit(Unit unit) => editingUnit = new Unit
    {
        Id = unit.Id,
        PropertyId = unit.PropertyId,
        Label = unit.Label,
        MarketRent = unit.MarketRent,
        Bedrooms = unit.Bedrooms,
        Bathrooms = unit.Bathrooms,
        SquareFeet = unit.SquareFeet,
    };

    private async Task SaveUnitAsync()
    {
        if (editingUnit is null || property is null)
        {
            return;
        }

        error = ValidateLabel(editingUnit.Label, editingUnit.Id);
        if (error is not null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var unit = await db.Units.FindAsync(editingUnit.Id);
        if (unit is not null)
        {
            unit.Label = editingUnit.Label.Trim();
            unit.MarketRent = editingUnit.MarketRent;
            unit.Bedrooms = editingUnit.Bedrooms;
            unit.Bathrooms = editingUnit.Bathrooms;
            unit.SquareFeet = editingUnit.SquareFeet;
            await db.SaveChangesAsync();
        }
        editingUnit = null;
        await LoadAsync();
    }

    private async Task AddUnitAsync()
    {
        if (property is null)
        {
            return;
        }

        error = ValidateLabel(newUnit.Label, 0);
        if (error is not null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        newUnit.PropertyId = property.Id;
        newUnit.Label = newUnit.Label.Trim();
        db.Units.Add(newUnit);
        await db.SaveChangesAsync();
        newUnit = new();
        await LoadAsync();
    }

    private string? ValidateLabel(string label, int unitId)
    {
        if (string.IsNullOrWhiteSpace(label))
        {
            return "Unit label is required.";
        }
        return property!.Units.Any(u => u.Id != unitId && string.Equals(u.Label, label.Trim(), StringComparison.OrdinalIgnoreCase))
            ? $"Unit {label.Trim()} already exists."
            : null;
    }

    private DepreciableAsset newAsset = new();
    private string? assetError;

    private async Task AddAssetAsync()
    {
        if (string.IsNullOrWhiteSpace(newAsset.Description) || newAsset.Cost <= 0 || newAsset.PlacedInService == default)
        {
            assetError = "Give a description, the date it went into service, and what it cost.";
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        newAsset.PropertyId = property!.Id;
        newAsset.Description = newAsset.Description.Trim();
        db.DepreciableAssets.Add(newAsset);
        await db.SaveChangesAsync();
        newAsset = new() { PlacedInService = today };
        assetError = null;
        await LoadAsync();
    }

    private async Task RemoveAssetAsync(int assetId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.DepreciableAssets.Where(a => a.Id == assetId).ExecuteDeleteAsync();
        await LoadAsync();
    }

    private async Task SavePropertyAsync()
    {
        if (property is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Properties.FindAsync(property.Id);
        if (entity is not null)
        {
            entity.Name = property.Name;
            entity.Street = property.Street;
            entity.City = property.City;
            entity.State = property.State;
            entity.PostalCode = property.PostalCode;
            entity.PurchaseDate = property.PurchaseDate;
            entity.PurchasePrice = property.PurchasePrice;
            entity.LandValue = property.LandValue;
            entity.BasisAdditions = property.BasisAdditions;
            entity.RentalStartDate = property.RentalStartDate;
            entity.Notes = property.Notes;
            await db.SaveChangesAsync();
            saved = true;
        }
    }
}

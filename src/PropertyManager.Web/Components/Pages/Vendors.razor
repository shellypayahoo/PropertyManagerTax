@page "/vendors"
@inject IDbContextFactory<PropertyManagerDbContext> DbFactory
@inject VendorService VendorService

<PageTitle>Vendors</PageTitle>

<h1>Vendors</h1>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5">Add vendor</h2>
        @* novalidate: the app checks the email itself and says what's wrong, instead of the browser silently refusing. *@
        <EditForm Model="form" OnValidSubmit="AddAsync" FormName="vendor" class="row g-2" novalidate>
            <div class="col-md-3"><InputText @bind-Value="form.Name" class="form-control" placeholder="Name" /></div>
            <div class="col-md-2"><InputText @bind-Value="form.Trade" class="form-control" placeholder="Trade (e.g. Plumber)" /></div>
            <div class="col-md-2"><InputText @bind-Value="form.Phone" class="form-control" placeholder="Phone" type="tel" /></div>
            <div class="col-md-3"><InputText @bind-Value="form.Email" class="form-control" placeholder="Email" type="email" /></div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Add</button>
            </div>
        </EditForm>
        <FormError Message="@error" />
        @if (status is not null) { <div class="alert alert-success py-1 px-2 mt-2 mb-0 small">@status</div> }
    </div>
</div>

<table class="table align-middle">
    <thead>
        <tr><th>Name</th><th>Trade</th><th>Phone</th><th>Email</th><th>Texts &amp; emails</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var v in vendors)
        {
            @if (editing?.Id == v.Id)
            {
                <tr class="table-light">
                    <td><input class="form-control form-control-sm" @bind="editing.Name" aria-label="Name" /></td>
                    <td><input class="form-control form-control-sm" @bind="editing.Trade" aria-label="Trade" /></td>
                    <td><input class="form-control form-control-sm" @bind="editing.Phone" type="tel" aria-label="Phone" /></td>
                    <td><input class="form-control form-control-sm" @bind="editing.Email" aria-label="Email" /></td>
                    <td></td>
                    <td class="text-nowrap text-end">
                        <button class="btn btn-sm btn-primary" @onclick="SaveEditAsync">Save</button>
                        <button class="btn btn-sm btn-link" @onclick="() => { editing = null; editError = null; }">Cancel</button>
                    </td>
                </tr>
                @if (editError is not null)
                {
                    <tr class="table-light"><td colspan="6"><FormError Message="@editError" /></td></tr>
                }
                continue;
            }
            <tr class="@(acting?.Id == v.Id ? "table-active" : "")">
                <td><a href="expenses?vendor=@v.Id" title="Show this vendor's expenses">@v.Name</a></td>
                <td>@v.Trade</td>
                <td>@v.Phone</td>
                <td>@v.Email</td>
                <td><KeepUntilEditor VendorId="v.Id" Name="@v.Name" Current="v.KeepMessagesUntil" OnChanged="LoadAsync" /></td>
                <td class="text-nowrap text-end">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => Edit(v)">Edit</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => StartAsync(v, merging: true)">Merge into…</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => StartAsync(v, merging: false)">Delete</button>
                </td>
            </tr>
            @if (acting?.Id == v.Id && usage is not null)
            {
                <tr>
                    <td colspan="6" class="bg-body-tertiary">
                        @if (merging)
                        {
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span>Merge <strong>@v.Name</strong> (@usage) into</span>
                                <select class="form-select form-select-sm w-auto" @bind="mergeInto">
                                    <option value="0">Choose the vendor to keep…</option>
                                    @foreach (var other in vendors.Where(o => o.Id != v.Id))
                                    {
                                        <option value="@other.Id">@other.Name</option>
                                    }
                                </select>
                                <button class="btn btn-sm btn-primary" disabled="@(mergeInto == 0)" @onclick="MergeAsync">Merge</button>
                                <button class="btn btn-sm btn-link" @onclick="() => acting = null">Cancel</button>
                            </div>
                            <div class="small text-muted mt-1">
                                Everything that uses @v.Name moves to the vendor you keep, which also gets any phone, email, or trade it's missing.
                                Then @v.Name is deleted.
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span>
                                    Delete <strong>@v.Name</strong>?
                                    @if (usage.IsUnused)
                                    {
                                        <span>It isn't used anywhere.</span>
                                    }
                                    else
                                    {
                                        <span>It's used by @usage; those are kept but will have no vendor. If it's a duplicate, use <strong>Merge into…</strong> instead.</span>
                                    }
                                </span>
                                <button class="btn btn-sm btn-danger" @onclick="DeleteAsync">Delete</button>
                                <button class="btn btn-sm btn-link" @onclick="() => acting = null">Cancel</button>
                            </div>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private List<Vendor> vendors = [];
    private Vendor form = new();
    private Vendor? editing;
    private string? editError;
    private string? error;
    private string? status;
    private Vendor? acting;
    private VendorUsage? usage;
    private bool merging;
    private int mergeInto;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        vendors = await db.Vendors.AsNoTracking().OrderBy(v => v.Name).ToListAsync();
    }

    private void Edit(Vendor v)
    {
        acting = null;
        status = null;
        editError = null;
        editing = new Vendor { Id = v.Id, Name = v.Name, Trade = v.Trade, Phone = v.Phone, Email = v.Email, Notes = v.Notes };
    }

    private async Task AddAsync()
    {
        if (Problem(form) is { } problem)
        {
            error = problem;
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        Clean(form);
        db.Vendors.Add(form);
        await db.SaveChangesAsync();
        status = $"Added {form.Name}.";
        form = new();
        error = null;
        await LoadAsync();
    }

    private async Task SaveEditAsync()
    {
        if (Problem(editing!) is { } problem)
        {
            editError = problem;
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        // Only the fields on the row change; the message retention date and links are left as they are.
        if (await db.Vendors.FindAsync(editing!.Id) is { } vendor)
        {
            Clean(editing);
            (vendor.Name, vendor.Trade, vendor.Phone, vendor.Email) = (editing.Name, editing.Trade, editing.Phone, editing.Email);
            await db.SaveChangesAsync();
            status = $"Saved {vendor.Name}.";
        }
        editing = null;
        editError = null;
        await LoadAsync();
    }

    /// <summary>What's wrong with a vendor's details, or null.</summary>
    private string? Problem(Vendor v)
    {
        if (string.IsNullOrWhiteSpace(v.Name))
        {
            return "Name is required.";
        }
        var name = v.Name.Trim();
        if (vendors.Any(o => o.Id != v.Id && string.Equals(o.Name.Trim(), name, StringComparison.OrdinalIgnoreCase)))
        {
            return $"There's already a vendor named {name}. To combine them, use Merge into… on one of them.";
        }
        var email = v.Email?.Trim() ?? "";
        if (email.Length > 0 && !System.Text.RegularExpressions.Regex.IsMatch(email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
        {
            return $"\"{email}\" doesn't look like an email address (one address, no spaces, like name@example.com). Fix it or clear it.";
        }
        return null;
    }

    private static void Clean(Vendor v)
    {
        static string? Trim(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
        v.Name = v.Name.Trim();
        (v.Trade, v.Phone, v.Email, v.Notes) = (Trim(v.Trade), Trim(v.Phone), Trim(v.Email), Trim(v.Notes));
    }

    private async Task StartAsync(Vendor v, bool merging)
    {
        acting = v;
        this.merging = merging;
        mergeInto = 0;
        status = null;
        usage = await VendorService.GetUsageAsync(v.Id);
    }

    private async Task MergeAsync()
    {
        var keep = vendors.First(v => v.Id == mergeInto);
        await VendorService.MergeAsync(acting!.Id, keep.Id);
        status = $"Merged {acting.Name} into {keep.Name}.";
        await FinishAsync();
    }

    private async Task DeleteAsync()
    {
        await VendorService.DeleteAsync(acting!.Id);
        status = $"Deleted {acting.Name}.";
        await FinishAsync();
    }

    private async Task FinishAsync()
    {
        if (editing?.Id == acting!.Id)
        {
            editing = null;
        }
        acting = null;
        usage = null;
        await LoadAsync();
    }
}

@page "/expenses"
@inject IDbContextFactory<PropertyManagerDbContext> DbFactory
@inject TimeProvider Clock
@inject ExpenseSplitService SplitService
@inject RecurringExpenseService Recurring
@inject ReceiptService Receipts

<PageTitle>Expenses</PageTitle>

<div class="d-flex flex-wrap align-items-center gap-2 mb-2">
    <h1 class="me-auto mb-0">Expenses</h1>
    <a class="btn btn-outline-primary" href="expenses/recurring">Recurring</a>
    <a class="btn btn-outline-secondary" href="import">Import from bank</a>
</div>

@if (recurringAdded > 0)
{
    <div class="alert alert-info py-2">Added @recurringAdded recurring @(recurringAdded == 1 ? "expense" : "expenses") that came due.</div>
}

<div class="card mb-3">
<div class="card-body">
<h2 class="h5">Add expense</h2>
<EditForm Model="form" OnValidSubmit="AddAsync" FormName="expense" class="row g-2 align-items-end">
    <div class="col-md-2"><label class="form-label">Date</label><InputDate @bind-Value="form.Date" class="form-control" /></div>
    <div class="col-md-2">
        <label class="form-label">Property</label>
        <select class="form-select" value="@(addPropertyChosen ? PropertyValue(form.PropertyId) : "")" @onchange="OnAddPropertyChanged">
            <option value="">Select…</option>
            <option value="@SharedValue">All properties (shared)</option>
            @foreach (var p in properties)
            {
                <option value="@p.Id">@p.Name</option>
            }
        </select>
    </div>
    <div class="col-md-1">
        <label class="form-label">Unit</label>
        <InputSelect @bind-Value="form.UnitId" class="form-select" disabled="@(form.PropertyId is null)">
            <option value="">All</option>
            @foreach (var u in UnitsOf(form.PropertyId))
            {
                <option value="@u.Id">@u.Label</option>
            }
        </InputSelect>
    </div>
    <div class="col-md-2">
        <label class="form-label">Category</label>
        <InputSelect @bind-Value="form.Category" class="form-select">
            <CategoryOptions />
        </InputSelect>
    </div>
    <div class="col-md-2"><label class="form-label">Description</label><InputText @bind-Value="form.Description" class="form-control" /></div>
    <div class="col-md-1">
        <label class="form-label">Vendor</label>
        <InputSelect @bind-Value="form.VendorId" class="form-select">
            <option value="">—</option>
            @foreach (var v in vendors)
            {
                <option value="@v.Id">@v.Name</option>
            }
        </InputSelect>
    </div>
    <div class="col-md-1"><label class="form-label">Amount</label><InputNumber @bind-Value="form.Amount" class="form-control" /></div>
    <div class="col-md-1">
        <label class="form-label">Paid with</label>
        <InputSelect @bind-Value="form.PaidWith" class="form-select">
            <option value="">—</option>
            @foreach (var m in Enum.GetValues<PaymentMethod>())
            {
                <option value="@m">@m</option>
            }
        </InputSelect>
    </div>
    <div class="col-md-1"><button type="submit" class="btn btn-primary w-100">Add</button></div>
</EditForm>
<FormError Message="@error" />
@if (added is not null) { <div class="alert alert-success py-1 px-2 mt-2 mb-0 small">Added @added</div> }
<p class="small text-muted mt-1 mb-0">
    Use <strong>All properties (shared)</strong> for costs of the whole rental business, such as software, cloud hosting, or accounting.
    The annual report splits them across properties by number of units.
</p>
</div>
</div>

<div class="row g-2 mb-3">
    <div class="col-auto">
        <select class="form-select" @bind="year" @bind:after="LoadAsync">
            @foreach (var y in Enumerable.Range(today.Year - 5, 6).Reverse())
            {
                <option value="@y">@y</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <select class="form-select" @bind="propertyFilter" @bind:after="LoadAsync">
            <option value="0">All expenses</option>
            <option value="@SharedFilter">Shared by all properties</option>
            @foreach (var p in properties)
            {
                <option value="@p.Id">@p.Name</option>
            }
        </select>
    </div>
    <div class="col-auto form-check align-self-center ms-2">
        <input class="form-check-input" type="checkbox" id="no-receipt" @bind="withoutReceiptOnly" />
        <label class="form-check-label" for="no-receipt">Without a receipt only</label>
    </div>
    <div class="col-auto ms-auto fs-5">Total: <strong>@Shown.Sum(e => e.Amount).ToString("C")</strong></div>
</div>

@if (selected.Count > 0)
{
    <div class="card mb-2">
        <div class="card-body py-2 d-flex flex-wrap gap-2 align-items-center">
            <span class="small">@selected.Count selected. Change to:</span>
            <select class="form-select form-select-sm w-auto" @bind="bulkProperty">
                <option value="">Property…</option>
                <option value="@SharedValue">All properties (shared)</option>
                @foreach (var p in properties) { <option value="@p.Id">@p.Name</option> }
            </select>
            <select class="form-select form-select-sm w-auto" @bind="bulkCategory">
                <option value="">Category…</option>
                <CategoryOptions />
            </select>
            <select class="form-select form-select-sm w-auto" @bind="bulkVendor">
                <option value="">Vendor…</option>
                <option value="@NoVendorValue">No vendor</option>
                @foreach (var v in vendors) { <option value="@v.Id">@v.Name</option> }
            </select>
            <button class="btn btn-sm btn-primary" disabled="@(bulkProperty == "" && bulkCategory == "" && bulkVendor == "")" @onclick="ApplyBulkAsync">Apply</button>
            <button class="btn btn-sm btn-link" @onclick="() => selected.Clear()">Clear selection</button>
        </div>
    </div>
}

<table class="table table-sm align-middle">
    <thead>
        <tr>
            <th><input type="checkbox" class="form-check-input" title="Select all"
                       checked="@(expenses.Count > 0 && selected.Count == expenses.Count)" @onchange="e => SelectAll((bool)e.Value!)" /></th>
            <th>Date</th><th>Property</th><th>Unit</th><th>Category</th><th>Description</th><th>Vendor</th><th>Paid with</th><th class="text-end">Amount</th><th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Shown)
        {
            if (editing?.Id == e.Id)
            {
                <tr class="table-light">
                    <td></td>
                    <td><input type="date" class="form-control form-control-sm" @bind="editing.Date" /></td>
                    <td>
                        <select class="form-select form-select-sm" value="@PropertyValue(editing.PropertyId)" @onchange="ev => SetProperty(editing, ev.Value as string)">
                            <option value="@SharedValue">All properties (shared)</option>
                            @foreach (var p in properties) { <option value="@p.Id">@p.Name</option> }
                        </select>
                    </td>
                    <td>
                        @if (editing.PropertyId is not null)
                        {
                            <select class="form-select form-select-sm" @bind="editing.UnitId">
                                <option value="">All</option>
                                @foreach (var u in UnitsOf(editing.PropertyId)) { <option value="@u.Id">@u.Label</option> }
                            </select>
                        }
                    </td>
                    <td>
                        <select class="form-select form-select-sm" @bind="editing.Category">
                            <CategoryOptions />
                        </select>
                    </td>
                    <td><input class="form-control form-control-sm" @bind="editing.Description" /></td>
                    <td>
                        <select class="form-select form-select-sm" @bind="editing.VendorId">
                            <option value="">—</option>
                            @foreach (var v in vendors) { <option value="@v.Id">@v.Name</option> }
                        </select>
                    </td>
                    <td>
                        <select class="form-select form-select-sm" @bind="editing.PaidWith">
                            <option value="">—</option>
                            @foreach (var m in Enum.GetValues<PaymentMethod>()) { <option value="@m">@m</option> }
                        </select>
                    </td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm text-end" style="width: 7rem" @bind="editing.Amount" /></td>
                    <td class="text-nowrap">
                        <button class="btn btn-sm btn-success" @onclick="SaveEditAsync">Save</button>
                        <button class="btn btn-sm btn-link" @onclick="() => editing = null">Cancel</button>
                    </td>
                </tr>
                @if (editError is not null)
                {
                    <tr class="table-light"><td></td><td colspan="9"><FormError Message="@editError" /></td></tr>
                }
            }
            else
            {
                <tr>
                    <td><input type="checkbox" class="form-check-input" checked="@selected.Contains(e.Id)" @onchange="ev => Toggle(e.Id, (bool)ev.Value!)" /></td>
                    <td>@e.Date.ToString("d")</td>
                    <td>
                        @if (e.IsShared)
                        {
                            <span class="badge text-bg-info" title="Split across all properties on the annual report">All properties</span>
                        }
                        else
                        {
                            @e.Property?.Name
                        }
                    </td>
                    <td>@e.Unit?.Label</td>
                    <td>@e.Category.DisplayName()</td>
                    <td>
                        @e.Description
                        @if (!string.IsNullOrWhiteSpace(e.Notes)) { <div class="small text-muted text-truncate" style="max-width: 24rem" title="@e.Notes">@e.Notes</div> }
                    </td>
                    <td>@e.Vendor?.Name</td>
                    <td>@e.PaidWith</td>
                    <td class="text-end">@e.Amount.ToString("C")</td>
                    <td class="text-nowrap">
                        <button class="btn btn-sm @(e.Receipts.Count > 0 ? "btn-outline-success" : "btn-outline-secondary")" title="Receipts"
                                @onclick="() => ToggleReceipts(e.Id)">📎@(e.Receipts.Count > 0 ? $" {e.Receipts.Count}" : "")</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => StartEdit(e)">Edit</button>
                        <button class="btn btn-sm btn-outline-secondary" title="Split into several categories, e.g. a mortgage payment" @onclick="() => StartSplit(e)">Split</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(e.Id)">Delete</button>
                    </td>
                </tr>
                @if (receiptsOpen == e.Id)
                {
                    <tr class="table-light" id="expense-@e.Id">
                        <td></td>
                        <td colspan="9">
                            <div class="d-flex flex-wrap align-items-start gap-3 mb-2">
                                @foreach (var r in e.Receipts.OrderBy(r => r.UploadedAt.UtcTicks))
                                {
                                    <div class="text-center small" style="width: 130px">
                                        @if (r.IsImage)
                                        {
                                            <a href="@($"receipts/{r.Id}{(r.PreviewKey is null ? "" : "?size=preview")}")" target="_blank">
                                                <img src="@($"receipts/{r.Id}{(r.ThumbnailKey is null ? "" : "?size=thumb")}")" alt="@r.FileName" class="rounded border" style="max-width: 120px; max-height: 120px; object-fit: cover" />
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="receipts/@r.Id" target="_blank" class="d-block fs-2 text-decoration-none">📄</a>
                                        }
                                        <div class="text-truncate" title="@r.FileName">@r.FileName</div>
                                        <button class="btn btn-link btn-sm p-0 link-danger" @onclick="() => DeleteReceiptAsync(r.Id)">Remove</button>
                                    </div>
                                }
                                @if (e.Receipts.Count == 0) { <span class="small text-muted">No receipt attached yet.</span> }
                            </div>
                            @if (receiptMessage is not null) { <div class="alert alert-success py-1 px-2 small">@receiptMessage</div> }
                            @if (receiptError is not null) { <div class="alert alert-warning py-1 px-2 small">@receiptError</div> }
                            <form method="post" action="expenses/@e.Id/receipts" enctype="multipart/form-data" data-file-upload data-return-hash="#expense-@e.Id">
                                <AntiforgeryToken />
                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                    <input type="file" name="files" multiple required class="form-control form-control-sm w-auto"
                                           accept="image/*,.heic,.pdf,.doc,.docx" />
                                    <button type="submit" class="btn btn-sm btn-primary">Attach</button>
                                    <button type="button" class="btn btn-sm btn-link" @onclick="() => receiptsOpen = null">Close</button>
                                </div>
                                <div class="small text-muted mt-1">Photo of the receipt (on a phone you can take one with the camera), or a PDF or Word invoice.</div>
                                <div class="alert alert-danger small mt-2" data-upload-message hidden></div>
                            </form>
                        </td>
                    </tr>
                }
                @if (splitting == e.Id)
                {
                    var remaining = e.Amount - splitParts.Sum(p => p.Amount);
                    <tr class="table-light">
                        <td></td>
                        <td colspan="9">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <strong>Split @e.Amount.ToString("C")</strong>
                                <span class="small text-muted">Use the amounts from the statement.</span>
                                <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="() => showUnitPicker = !showUnitPicker">Divide across units</button>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => UseMortgageParts(e)">Mortgage payment</button>
                            </div>
                            @if (showUnitPicker)
                            {
                                <div class="border rounded p-2 mb-2 bg-body">
                                    <div class="small mb-1">Which units did this cover? The amount is divided evenly.</div>
                                    @foreach (var p in properties)
                                    {
                                        <div class="d-flex flex-wrap gap-3 mb-1">
                                            <span class="small fw-semibold" style="min-width: 10rem">@p.Name</span>
                                            @foreach (var u in p.Units.OrderBy(u => u.Label))
                                            {
                                                <label class="form-check-label small">
                                                    <input type="checkbox" class="form-check-input me-1" checked="@pickedUnits.Contains(u.Id)"
                                                           @onchange="ev => { if ((bool)ev.Value!) pickedUnits.Add(u.Id); else pickedUnits.Remove(u.Id); }" />Unit @u.Label
                                                </label>
                                            }
                                        </div>
                                    }
                                    <button class="btn btn-sm btn-primary mt-1" disabled="@(pickedUnits.Count < 2)" @onclick="() => DivideAcrossUnits(e)">
                                        Divide @e.Amount.ToString("C") across @pickedUnits.Count units
                                    </button>
                                </div>
                            }
                            @foreach (var part in splitParts)
                            {
                                <div class="d-flex flex-wrap gap-2 mb-1" style="max-width: 56rem">
                                    <select class="form-select form-select-sm" style="max-width: 12rem" value="@part.Location" @onchange="ev => { part.Location = (string)ev.Value!; part.UnitId = null; }">
                                        <option value="@SharedValue">All properties (shared)</option>
                                        @foreach (var p in properties) { <option value="@p.Id">@p.Name</option> }
                                    </select>
                                    <select class="form-select form-select-sm" style="max-width: 7rem" @bind="part.UnitId" disabled="@(part.Location == SharedValue)">
                                        <option value="">All units</option>
                                        @foreach (var u in UnitsOf(int.TryParse(part.Location, out var pid) ? pid : null)) { <option value="@u.Id">Unit @u.Label</option> }
                                    </select>
                                    <select class="form-select form-select-sm" style="max-width: 16rem" @bind="part.Category"><CategoryOptions /></select>
                                    <input type="number" step="0.01" class="form-control form-control-sm text-end" style="width: 8rem" @bind="part.Amount" @bind:event="oninput" />
                                    <button class="btn btn-sm btn-link text-danger" disabled="@(splitParts.Count <= 2)" @onclick="() => splitParts.Remove(part)">Remove</button>
                                </div>
                            }
                            <button class="btn btn-sm btn-link px-0" @onclick="() => splitParts.Add(NewPart(e, ExpenseCategory.Other))">+ Add a part</button>
                            @if (showEscrowHint)
                            {
                                <div class="small text-muted mt-1">
                                    Escrow deposits aren't deductible. When the lender pays your property tax or insurance bill from escrow,
                                    add that payment as a <strong>Taxes</strong> or <strong>Insurance</strong> expense (the escrow statement and Form 1098 list them).
                                </div>
                            }
                            <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                                <span class="@(remaining == 0 ? "text-success" : "text-danger")">
                                    @(remaining == 0 ? "Parts add up." : $"{(remaining > 0 ? "Left to assign" : "Over by")}: {Math.Abs(remaining):C}")
                                </span>
                                <button class="btn btn-sm btn-success" disabled="@(remaining != 0)" @onclick="() => SaveSplitAsync(e.Id)">Save split</button>
                                <button class="btn btn-sm btn-link" @onclick="() => splitting = null">Cancel</button>
                            </div>
                            <FormError Message="@splitError" />
                        </td>
                    </tr>
                }
            }
        }
    </tbody>
</table>


@code {
    /// <summary>Property dropdown value meaning "shared by all properties".</summary>
    private const string SharedValue = "shared";
    private const int SharedFilter = -1;
    private string? added;

    private List<Expense> expenses = [];
    private List<Property> properties = [];
    private List<Vendor> vendors = [];
    private Expense form = new();
    private bool addPropertyChosen;
    private int year;
    private int propertyFilter;
    private string? error;
    private DateOnly today;
    private int recurringAdded;

    private class SplitPart
    {
        public ExpenseCategory Category { get; set; }
        public decimal Amount { get; set; }

        /// <summary>A property id, or SharedValue for all properties.</summary>
        public string Location { get; set; } = SharedValue;
        public int? UnitId { get; set; }
    }

    private bool showUnitPicker;
    private HashSet<int> pickedUnits = [];

    private int? splitting;
    private bool showEscrowHint;
    private List<SplitPart> splitParts = [];
    private string? splitError;

    private Expense? editing;
    private string? editError;
    private HashSet<int> selected = [];
    private string bulkProperty = "";
    private string bulkCategory = "";
    private string bulkVendor = "";

    /// <summary>Bulk vendor dropdown value meaning "remove the vendor".</summary>
    private const string NoVendorValue = "none";

    // Set by the receipt upload endpoint when it redirects back here.
    [SupplyParameterFromQuery] public int? ReceiptsFor { get; set; }
    [SupplyParameterFromQuery] public int ReceiptsAdded { get; set; }
    [SupplyParameterFromQuery] public string? ReceiptError { get; set; }

    private int? receiptsOpen;
    private string? receiptMessage;
    private string? receiptError;
    private bool withoutReceiptOnly;

    private IEnumerable<Expense> Shown => withoutReceiptOnly ? expenses.Where(e => e.Receipts.Count == 0) : expenses;

    private void ToggleReceipts(int expenseId)
    {
        receiptsOpen = receiptsOpen == expenseId ? null : expenseId;
        receiptMessage = receiptError = null;
    }

    private async Task DeleteReceiptAsync(int receiptId)
    {
        await Receipts.DeleteAsync(receiptId);
        receiptMessage = "Receipt removed.";
        receiptError = null;
        await LoadAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        today = DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);
        year = today.Year;
        form = NewForm();

        await using var db = await DbFactory.CreateDbContextAsync();
        properties = await db.Properties.AsNoTracking().Include(p => p.Units).OrderBy(p => p.Name).ToListAsync();
        vendors = await db.Vendors.AsNoTracking().OrderBy(v => v.Name).ToListAsync();
        recurringAdded = await Recurring.GenerateDueAsync();
        if (ReceiptsFor is { } id && await db.Expenses.AsNoTracking().FirstOrDefaultAsync(e => e.Id == id) is { } uploadedTo)
        {
            // Back from uploading receipts: show that expense's year with its receipts open.
            year = uploadedTo.Date.Year;
            receiptsOpen = id;
            receiptMessage = ReceiptsAdded > 0 ? $"Attached {ReceiptsAdded} receipt{(ReceiptsAdded == 1 ? "" : "s")}." : null;
            receiptError = ReceiptError;
        }
        await LoadAsync();
    }

    private Expense NewForm() => new() { Date = today, Category = ExpenseCategory.Repairs };

    private static string PropertyValue(int? propertyId) => propertyId?.ToString() ?? SharedValue;

    private static void SetProperty(Expense expense, string? value)
    {
        expense.PropertyId = int.TryParse(value, out var id) ? id : null;
        expense.UnitId = null;
    }

    private void OnAddPropertyChanged(ChangeEventArgs e)
    {
        var value = e.Value as string;
        addPropertyChosen = !string.IsNullOrEmpty(value);
        SetProperty(form, value);
    }

    private IEnumerable<Unit> UnitsOf(int? propertyId) =>
        properties.FirstOrDefault(p => p.Id == propertyId)?.Units.OrderBy(u => u.Label) ?? Enumerable.Empty<Unit>();

    private async Task LoadAsync()
    {
        var start = new DateOnly(year, 1, 1);
        var end = new DateOnly(year, 12, 31);

        await using var db = await DbFactory.CreateDbContextAsync();
        var query = db.Expenses.AsNoTracking()
            .Include(e => e.Property).Include(e => e.Unit).Include(e => e.Vendor).Include(e => e.Receipts)
            .Where(e => e.Date >= start && e.Date <= end);
        if (propertyFilter == SharedFilter)
        {
            query = query.Where(e => e.PropertyId == null);
        }
        else if (propertyFilter != 0)
        {
            query = query.Where(e => e.PropertyId == propertyFilter);
        }
        expenses = await query.OrderByDescending(e => e.Date).ThenByDescending(e => e.Id).ToListAsync();
        selected.IntersectWith(expenses.Select(e => e.Id));
    }

    private async Task AddAsync()
    {
        if (!addPropertyChosen || form.Amount <= 0 || string.IsNullOrWhiteSpace(form.Description))
        {
            error = "Property (or All properties), description, and a positive amount are required.";
            added = null;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        db.Expenses.Add(form);
        await db.SaveChangesAsync();
        added = $"{form.Description}, {form.Amount:C} on {form.Date:d}. Attach a receipt below if you have one.";
        receiptsOpen = form.Id;
        receiptMessage = receiptError = null;
        form = NewForm();
        addPropertyChosen = false;
        error = null;
        await LoadAsync();
    }

    private void StartEdit(Expense e)
    {
        splitting = null;
        editing = new Expense
        {
            Id = e.Id, Date = e.Date, PropertyId = e.PropertyId, UnitId = e.UnitId, Category = e.Category,
            Description = e.Description, VendorId = e.VendorId, PaidWith = e.PaidWith, Amount = e.Amount,
        };
        editError = null;
    }

    private async Task SaveEditAsync()
    {
        var e = editing!;
        if (e.Amount == 0 || string.IsNullOrWhiteSpace(e.Description))
        {
            editError = "Description and amount are required.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Expenses.FindAsync(e.Id);
        if (entity is not null)
        {
            entity.Date = e.Date;
            entity.PropertyId = e.PropertyId;
            entity.UnitId = e.PropertyId is null ? null : e.UnitId;
            entity.Category = e.Category;
            entity.Description = e.Description.Trim();
            entity.VendorId = e.VendorId;
            entity.PaidWith = e.PaidWith;
            entity.Amount = e.Amount;
            await db.SaveChangesAsync();
        }
        editing = null;
        await LoadAsync();
    }

    private void StartSplit(Expense e)
    {
        editing = null;
        splitting = e.Id;
        splitError = null;
        showEscrowHint = false;
        showUnitPicker = false;
        pickedUnits = [];
        var first = NewPart(e, e.Category);
        first.Amount = e.Amount;
        splitParts = [first, NewPart(e, ExpenseCategory.Other)];
    }

    /// <summary>A split part on the original expense's property and unit.</summary>
    private static SplitPart NewPart(Expense e, ExpenseCategory category) => new()
    {
        Category = category,
        Location = PropertyValue(e.PropertyId),
        UnitId = e.UnitId,
    };

    private void DivideAcrossUnits(Expense e)
    {
        var picked = properties.SelectMany(p => p.Units.OrderBy(u => u.Label)).Where(u => pickedUnits.Contains(u.Id)).ToList();
        var amounts = ExpenseSplitService.DivideEvenly(e.Amount, picked.Count);
        splitParts = picked.Select((u, i) => new SplitPart
        {
            Category = e.Category,
            Amount = amounts[i],
            Location = u.PropertyId.ToString(),
            UnitId = u.Id,
        }).ToList();
        showUnitPicker = false;
    }

    /// <summary>Interest, principal, and escrow deposit, as on a mortgage statement.</summary>
    private void UseMortgageParts(Expense e)
    {
        splitParts =
        [
            NewPart(e, ExpenseCategory.MortgageInterest),
            NewPart(e, ExpenseCategory.MortgagePrincipal),
            NewPart(e, ExpenseCategory.EscrowDeposit),
        ];
        showEscrowHint = true;
    }

    private async Task SaveSplitAsync(int expenseId)
    {
        try
        {
            await SplitService.SplitAsync(expenseId, splitParts
                .Select(p => new ExpenseSplitPart(p.Category, p.Amount,
                    new ExpenseLocation(int.TryParse(p.Location, out var id) ? id : null, p.UnitId)))
                .ToList());
            splitting = null;
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            splitError = ex.Message;
        }
    }

    private void Toggle(int id, bool isSelected)
    {
        if (isSelected)
        {
            selected.Add(id);
        }
        else
        {
            selected.Remove(id);
        }
    }

    private void SelectAll(bool isSelected)
    {
        selected.Clear();
        if (isSelected)
        {
            selected.UnionWith(expenses.Select(e => e.Id));
        }
    }

    private async Task ApplyBulkAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var targets = await db.Expenses.Where(e => selected.Contains(e.Id)).ToListAsync();
        foreach (var e in targets)
        {
            if (bulkProperty != "")
            {
                SetProperty(e, bulkProperty);
            }
            if (Enum.TryParse<ExpenseCategory>(bulkCategory, out var category))
            {
                e.Category = category;
            }
            if (bulkVendor == NoVendorValue)
            {
                e.VendorId = null;
            }
            else if (int.TryParse(bulkVendor, out var vendorId))
            {
                e.VendorId = vendorId;
            }
        }
        await db.SaveChangesAsync();
        selected.Clear();
        bulkProperty = bulkCategory = bulkVendor = "";
        await LoadAsync();
    }

    private async Task DeleteAsync(int expenseId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        // Keep the import record (so the bank row isn't re-imported) but unlink it from the expense.
        await db.ImportedTransactions.Where(t => t.ExpenseId == expenseId)
            .ExecuteUpdateAsync(u => u.SetProperty(t => t.ExpenseId, (int?)null).SetProperty(t => t.Kind, TransactionKind.Ignored));
        await Receipts.DeleteFilesForExpenseAsync(expenseId);
        await db.Expenses.Where(e => e.Id == expenseId).ExecuteDeleteAsync();
        selected.Remove(expenseId);
        await LoadAsync();
    }
}

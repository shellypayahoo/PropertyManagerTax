@page "/reports"
@inject ReportService ReportService
@inject TimeProvider Clock

<PageTitle>Reports</PageTitle>

<h1>Annual profit &amp; loss</h1>
<p class="text-muted">
    Expenses are grouped by IRS Schedule E line. Rents received are the payments recorded on each lease, entered
    by hand or imported from your bank. Scheduled rent is what the leases call for, shown for comparison.
    Click a line name or an amount to see the items behind it.
</p>

<div class="d-flex flex-wrap align-items-center gap-3 mb-3">
    <select class="form-select w-auto" @bind="year" @bind:after="LoadAsync">
        @foreach (var y in Enumerable.Range(currentYear - 5, 6).Reverse())
        {
            <option value="@y">@y</option>
        }
    </select>
    <a class="btn btn-outline-primary" href="reports/@year/profit-and-loss.pdf@(includeDetail ? "?detail=true" : "")" target="_blank">Download PDF</a>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="pdf-detail" @bind="includeDetail" />
        <label class="form-check-label" for="pdf-detail">Include every item behind each line</label>
    </div>
</div>

@if (statements is null)
{
    <p><em>Loading…</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Line</th>
                    <th></th>
                    @foreach (var s in statements) { <th class="text-end">@s.PropertyName</th> }
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                <tr class="fw-semibold">
                    <td>3</td>
                    <td><button class="btn btn-link p-0 fw-semibold text-start" title="Show the payments" @onclick="() => OpenAsync(null, null)">Rents received</button></td>
                    @foreach (var s in statements)
                    {
                        <td class="text-end"><button class="btn btn-link p-0 fw-semibold" @onclick="() => OpenAsync(null, s.PropertyId)">@s.RentReceived.ToString("C")</button></td>
                    }
                    <td class="text-end">@statements.Sum(s => s.RentReceived).ToString("C")</td>
                </tr>
                @if (open is { Category: null } rentKey)
                {
                    <ReportDetailPanel Title="@DetailTitle(rentKey)" Detail="detail" ForOneProperty="rentKey.PropertyId is not null" PartyHeader="How paid"
                                       ColumnCount="statements.Count + 3" OnClose="() => open = null" />
                }
                <tr class="text-muted small">
                    <td></td>
                    <td>Scheduled rent (for comparison)</td>
                    @foreach (var s in statements) { <td class="text-end">@s.ScheduledRent.ToString("C")</td> }
                    <td class="text-end">@statements.Sum(s => s.ScheduledRent).ToString("C")</td>
                </tr>
                @foreach (var category in UsedCategories)
                {
                    <tr>
                        <td>@category.ScheduleELine()</td>
                        <td><button class="btn btn-link p-0 text-start" title="Show the expenses" @onclick="() => OpenAsync(category, null)">@category.DisplayName()</button></td>
                        @foreach (var s in statements)
                        {
                            <td class="text-end">
                                @if (Amount(s, category) != "")
                                {
                                    <button class="btn btn-link p-0" @onclick="() => OpenAsync(category, s.PropertyId)">@Amount(s, category)</button>
                                }
                            </td>
                        }
                        <td class="text-end">@statements.Sum(s => s.Expenses.Where(e => e.Category == category).Sum(e => e.Amount)).ToString("C")</td>
                    </tr>
                    @if (open is { } key && key.Category == category)
                    {
                        <ReportDetailPanel Title="@DetailTitle(key)" Detail="detail" ForOneProperty="key.PropertyId is not null"
                                           ColumnCount="statements.Count + 3" OnClose="() => open = null" />
                    }
                }
                <tr class="fw-semibold border-top">
                    <td>20</td>
                    <td>Total expenses</td>
                    @foreach (var s in statements) { <td class="text-end">@s.TotalExpenses.ToString("C")</td> }
                    <td class="text-end">@statements.Sum(s => s.TotalExpenses).ToString("C")</td>
                </tr>
                <tr class="fw-bold">
                    <td>21</td>
                    <td>Net income (loss)</td>
                    @foreach (var s in statements) { <td class="text-end @(s.NetIncome < 0 ? "text-danger" : "")">@s.NetIncome.ToString("C")</td> }
                    <td class="text-end">@statements.Sum(s => s.NetIncome).ToString("C")</td>
                </tr>
            </tbody>
        </table>
    </div>
    @if (statements.Any(s => s.NotDeductible.Count > 0))
    {
        <p class="small">
            Not included above (not deductible):
            @string.Join("; ", statements.SelectMany(s => s.NotDeductible).GroupBy(n => n.Category).Select(g => $"{g.Key.DisplayName().Replace(" (not deductible)", "").ToLowerInvariant()} {g.Sum(n => n.Amount):C}")).
            Principal repays the loan, and escrow deposits only become deductible when the lender pays your property taxes
            and insurance out of escrow; record those payments as Taxes and Insurance.
        </p>
    }
    @if (statements.Any(s => s.SharedExpenses != 0))
    {
        <p class="small">
            Includes @statements.Sum(s => s.SharedExpenses).ToString("C") of expenses shared by all properties, split by number of units:
            @string.Join(", ", statements.Select(s => $"{s.PropertyName} {s.SharedExpenses:C}")).
        </p>
    }
    <p class="small text-muted">This is a bookkeeping summary, not tax advice. Check the figures with your tax preparer before filing.</p>
}

@code {
    private IReadOnlyList<PropertyProfitAndLoss>? statements;
    private int year;
    private int currentYear;
    private bool includeDetail = true;

    private IEnumerable<ExpenseCategory> UsedCategories =>
        statements!.SelectMany(s => s.Expenses).Select(e => e.Category).Distinct().Order();

    protected override async Task OnInitializedAsync()
    {
        currentYear = Clock.GetLocalNow().Year;
        year = currentYear;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        statements = await ReportService.GetAnnualProfitAndLossAsync(year);
        open = null;
    }

    // The report cell whose details are shown: a category (null = rent received) and a property (null = all).
    private record DetailKey(ExpenseCategory? Category, int? PropertyId);

    private DetailKey? open;
    private ReportDetail? detail;

    private async Task OpenAsync(ExpenseCategory? category, int? propertyId)
    {
        var key = new DetailKey(category, propertyId);
        if (open == key)
        {
            open = null;
            return;
        }
        open = key;
        detail = null;
        detail = await ReportService.GetDetailAsync(year, category, propertyId);
    }

    private string DetailTitle(DetailKey key) =>
        $"{(key.Category is { } c ? c.DisplayName() : "Rents received")} – " +
        $"{(key.PropertyId is { } id ? statements!.First(s => s.PropertyId == id).PropertyName : "all properties")}, {year}";

    private static string Amount(PropertyProfitAndLoss s, ExpenseCategory c) =>
        s.Expenses.FirstOrDefault(e => e.Category == c)?.Amount.ToString("C") ?? "";
}

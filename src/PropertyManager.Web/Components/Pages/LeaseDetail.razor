@page "/leases/{Id:int}"
@using PropertyManager.Core.Storage
@inject IDbContextFactory<PropertyManagerDbContext> DbFactory
@inject IDocumentStorage Storage
@inject TimeProvider Clock

<PageTitle>Lease</PageTitle>

@if (lease is null)
{
    <p><em>@(loaded ? "Lease not found." : "Loading…")</em></p>
}
else
{
    <p><a href="leases">← Leases</a></p>
    <h1>@lease.TenantNames</h1>
    <p class="text-muted">@lease.Unit?.DisplayName</p>

    <h2 class="h4 mt-4">Tenants</h2>
    <ul class="list-group mb-2" style="max-width: 32rem">
        @foreach (var t in lease.Tenants.OrderBy(t => t.LastName).ThenBy(t => t.FirstName))
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>
                    @t.FullName
                    @if (!string.IsNullOrWhiteSpace(t.Phone) || !string.IsNullOrWhiteSpace(t.Email))
                    {
                        <span class="small text-muted ms-2">@t.Phone @t.Email</span>
                    }
                </span>
                @if (lease.Tenants.Count > 1)
                {
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveTenantAsync(t.Id)">Remove</button>
                }
            </li>
        }
    </ul>
    var others = allTenants.Where(t => lease.Tenants.All(lt => lt.Id != t.Id)).ToList();
    @if (others.Count > 0)
    {
        <div class="d-flex gap-2" style="max-width: 32rem">
            <select class="form-select" @bind="tenantToAdd">
                <option value="0">Add a roommate or co-signer…</option>
                @foreach (var t in others) { <option value="@t.Id">@t.FullName</option> }
            </select>
            <button class="btn btn-outline-primary text-nowrap" disabled="@(tenantToAdd == 0)" @onclick="AddTenantAsync">Add to lease</button>
        </div>
    }
    <p class="small text-muted mt-1">Not listed? Add them on the <a href="tenants">Tenants</a> page first. Rent payments from anyone on this lease count toward it.</p>

    <h2 class="h4 mt-4">Lease terms</h2>
    <EditForm Model="form" OnValidSubmit="SaveAsync" FormName="edit-lease" class="row g-2 align-items-end">
        <div class="col-md-3"><label class="form-label">Start</label><InputDate @bind-Value="form.StartDate" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">End (blank = month-to-month)</label><InputDate @bind-Value="form.EndDate" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">Monthly rent</label><InputNumber @bind-Value="form.MonthlyRent" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">Security deposit</label><InputNumber @bind-Value="form.SecurityDeposit" class="form-control" /></div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Save</button>
        </div>
    </EditForm>
    <FormError Message="@error" />
    @if (saved) { <div class="text-success small mt-1">Saved.</div> }

    <div class="d-flex align-items-center gap-3 mt-5 mb-2">
        <h2 class="h4 mb-0">Rent</h2>
        <select class="form-select form-select-sm w-auto" @bind="rentYear">
            @for (var y = DateOnly.FromDateTime(Clock.GetLocalNow().DateTime).Year; y >= lease.StartDate.Year; y--)
            {
                <option value="@y">@y</option>
            }
        </select>
    </div>
    var today = DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);
    var months = RentSchedule.ForYear(lease, rentYear, today);
    var problems = RentSchedule.FindProblems([lease], today);
    @if (problems.Count > 0)
    {
        <div class="alert alert-warning py-2" style="max-width: 56rem">
            <strong>Check these payments</strong>, they may have been entered twice:
            @foreach (var p in problems)
            {
                <button class="btn btn-sm btn-outline-dark ms-2 my-1" @onclick="() => rentYear = p.Month.Year">@p.Month.ToString("MMM yyyy"): @p.Warning</button>
            }
            <div class="small">Click <em>Edit</em> next to a payment to fix or delete it.</div>
        </div>
    }
    var behind = months.Where(m => m.Status is RentStatus.Unpaid or RentStatus.Partial).Sum(m => m.Balance);
    @if (months.Count == 0)
    {
        <p class="text-muted">No rent due in @rentYear.</p>
    }
    else
    {
        <p>
            @months.Count(m => m.Status == RentStatus.Paid) of @months.Count(m => m.Status != RentStatus.NotDue) months paid
            @if (behind > 0) { <span class="text-danger">· @behind.ToString("C0") unpaid</span> }
        </p>
        <table class="table align-middle" style="max-width: 56rem">
            <thead><tr><th>Month</th><th class="text-end">Rent</th><th class="text-end">Paid</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var m in months)
                {
                    <tr>
                        <td>
                            @m.Month.ToString("MMMM")
                            <PaymentList Payments="m.Payments" OnChanged="LoadAsync" />
                        </td>
                        <td class="text-end">@(m.Due == 0 ? "—" : m.Due.ToString("C0"))</td>
                        <td class="text-end">@(m.Paid == 0 ? "—" : m.Paid.ToString("C0"))</td>
                        <td><RentStatusBadge Month="m" /></td>
                        <td class="text-end">
                            @if (recordingMonth != m.Month)
                            {
                                <button class="btn btn-sm @(m.Status == RentStatus.Paid ? "btn-outline-secondary" : "btn-success")" @onclick="() => recordingMonth = m.Month">
                                    @(m.Paid == 0 ? "Mark paid" : "Add payment")
                                </button>
                            }
                        </td>
                    </tr>
                    @if (recordingMonth == m.Month)
                    {
                        <tr class="table-light">
                            <td colspan="5">
                                <RecordPaymentForm LeaseId="lease.Id" Month="m.Month" Amount="Math.Max(m.Balance, 0m)"
                                                   OnSaved="PaymentSavedAsync" OnCancel="() => recordingMonth = null" />
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
    <p class="small text-muted mt-1">See every unit for a month on the <a href="rent">Rent</a> page. Zelle payments can be brought in all at once from the <a href="import">Import</a> page.</p>

    <h2 class="h4 mt-5" id="documents">Documents</h2>
    @if (Uploaded > 0)
    {
        <div class="alert alert-success py-2">Uploaded @Uploaded @(Uploaded == 1 ? "file" : "files").</div>
    }
    <FormError Message="@UploadError" />
    @if (lease.Documents.Count == 0)
    {
        <p class="text-muted">No documents uploaded yet.</p>
    }
    else
    {
        <table class="table align-middle">
            <thead><tr><th>File</th><th class="text-end">Size</th><th>Uploaded</th><th></th></tr></thead>
            <tbody>
                @foreach (var d in lease.Documents.OrderByDescending(d => d.UploadedAt))
                {
                    <tr>
                        <td><a href="documents/@d.Id" target="_blank">@d.FileName</a></td>
                        <td class="text-end">@FormatSize(d.SizeBytes)</td>
                        <td>@d.UploadedAt.ToLocalTime().ToString("g")</td>
                        <td class="text-nowrap text-end">
                            <a class="btn btn-sm btn-outline-secondary" href="documents/@d.Id?download=true">Download</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteDocumentAsync(d)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <form method="post" action="leases/@lease.Id/documents" enctype="multipart/form-data" class="mt-3"
          onsubmit="var b = this.querySelector('button'); b.disabled = true; b.textContent = 'Uploading…';">
        <AntiforgeryToken />
        <label class="form-label" for="lease-files">Upload signed lease, addenda, or move-in inspection (PDF, Word, or image, up to @(LeaseDocumentService.MaxFileBytes / 1024 / 1024) MB each)</label>
        <div class="d-flex gap-2">
            <input type="file" id="lease-files" name="files" multiple required class="form-control"
                   accept="@string.Join(',', LeaseDocumentService.AllowedTypes.Keys)" />
            <button type="submit" class="btn btn-primary text-nowrap">Upload</button>
        </div>
    </form>
}

@code {
    [Parameter] public int Id { get; set; }

    // Set by the upload endpoint when it redirects back here.
    [SupplyParameterFromQuery] public int Uploaded { get; set; }
    [SupplyParameterFromQuery] public string? UploadError { get; set; }

    private Lease? lease;
    private Lease form = new();
    private bool loaded;
    private bool saved;
    private string? error;
    private int rentYear;
    private DateOnly? recordingMonth;
    private List<Tenant> allTenants = [];
    private int tenantToAdd;

    protected override async Task OnParametersSetAsync()
    {
        rentYear = DateOnly.FromDateTime(Clock.GetLocalNow().DateTime).Year;
        await LoadAsync();
        if (lease is not null)
        {
            form = new Lease
            {
                StartDate = lease.StartDate,
                EndDate = lease.EndDate,
                MonthlyRent = lease.MonthlyRent,
                SecurityDeposit = lease.SecurityDeposit,
            };
        }
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        lease = await db.Leases.AsNoTracking()
            .Include(l => l.Tenants)
            .Include(l => l.Unit).ThenInclude(u => u!.Property)
            .Include(l => l.Documents)
            .Include(l => l.Payments)
            .FirstOrDefaultAsync(l => l.Id == Id);
        allTenants = await db.Tenants.AsNoTracking().OrderBy(t => t.LastName).ThenBy(t => t.FirstName).ToListAsync();
        loaded = true;
    }

    private async Task AddTenantAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Leases.Include(l => l.Tenants).SingleAsync(l => l.Id == Id);
        if (entity.Tenants.All(t => t.Id != tenantToAdd) && await db.Tenants.FindAsync(tenantToAdd) is { } tenant)
        {
            entity.Tenants.Add(tenant);
            await db.SaveChangesAsync();
        }
        tenantToAdd = 0;
        await LoadAsync();
    }

    private async Task RemoveTenantAsync(int tenantId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Leases.Include(l => l.Tenants).SingleAsync(l => l.Id == Id);
        // A lease always keeps at least one tenant.
        if (entity.Tenants.Count > 1)
        {
            entity.Tenants.RemoveAll(t => t.Id == tenantId);
            await db.SaveChangesAsync();
        }
        await LoadAsync();
    }

    private async Task SaveAsync()
    {
        saved = false;
        error = await ValidateAsync();
        if (error is not null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Leases.FindAsync(Id);
        if (entity is not null)
        {
            entity.StartDate = form.StartDate;
            entity.EndDate = form.EndDate;
            entity.MonthlyRent = form.MonthlyRent;
            entity.SecurityDeposit = form.SecurityDeposit;
            await db.SaveChangesAsync();
            saved = true;
        }
        await LoadAsync();
    }

    private async Task<string?> ValidateAsync()
    {
        if (form.EndDate is { } end && end < form.StartDate)
        {
            return "End date must be on or after the start date.";
        }
        if (form.MonthlyRent <= 0)
        {
            return "Rent must be greater than zero.";
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var others = await db.Leases.AsNoTracking().Include(l => l.Tenants)
            .Where(l => l.UnitId == lease!.UnitId && l.Id != Id)
            .ToListAsync();
        var overlap = others.FirstOrDefault(l => l.StartDate <= (form.EndDate ?? DateOnly.MaxValue)
            && (l.EndDate ?? DateOnly.MaxValue) >= form.StartDate);
        return overlap is null
            ? null
            : $"Those dates overlap the lease for {overlap.TenantNames} ({overlap.StartDate:d} – {overlap.EndDate?.ToString("d") ?? "month-to-month"}).";
    }

    private async Task DeleteDocumentAsync(LeaseDocument document)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.LeaseDocuments.Where(d => d.Id == document.Id).ExecuteDeleteAsync();
        await Storage.DeleteAsync(document.StorageKey);
        await LoadAsync();
    }

    private async Task PaymentSavedAsync()
    {
        recordingMonth = null;
        await LoadAsync();
    }

    private static string FormatSize(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / 1024.0 / 1024.0:0.0} MB"
        : bytes >= 1024 ? $"{bytes / 1024.0:0} KB"
        : $"{bytes} B";
}

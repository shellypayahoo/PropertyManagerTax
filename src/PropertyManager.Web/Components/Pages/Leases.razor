@page "/leases"
@inject IDbContextFactory<PropertyManagerDbContext> DbFactory
@inject TimeProvider Clock
@inject NavigationManager Navigation

<PageTitle>Leases</PageTitle>

<h1>Leases</h1>

<div class="form-check mb-2">
    <input class="form-check-input" type="checkbox" id="showEnded" @bind="showEnded" />
    <label class="form-check-label" for="showEnded">Show ended leases</label>
</div>

<table class="table align-middle">
    <thead>
        <tr><th>Unit</th><th>Tenants</th><th>Start</th><th>End</th><th class="text-end">Rent</th><th class="text-end">Deposit</th><th class="text-end">Docs</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var l in leases.Where(l => showEnded || l.EndDate is null || l.EndDate >= today))
        {
            <tr class="@(l.IsActiveOn(today) ? "" : "text-muted")">
                <td>@l.Unit?.DisplayName</td>
                <td><a href="leases/@l.Id">@l.TenantNames</a></td>
                <td>@l.StartDate.ToString("d")</td>
                <td>@(l.EndDate?.ToString("d") ?? "Month-to-month")</td>
                <td class="text-end">@l.MonthlyRent.ToString("C0")</td>
                <td class="text-end">@l.SecurityDeposit.ToString("C0")</td>
                <td class="text-end">@(l.Documents.Count == 0 ? "" : l.Documents.Count.ToString())</td>
                <td>
                    @if (l.IsActiveOn(today))
                    {
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => EndLeaseAsync(l.Id)">End today</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<h2 class="h4 mt-4">New lease</h2>
@if (tenants.Count == 0)
{
    <p>Add a <a href="tenants">tenant</a> first.</p>
}
else
{
    <EditForm Model="form" OnValidSubmit="AddAsync" FormName="lease" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Unit</label>
            <InputSelect TValue="int" Value="form.UnitId" ValueChanged="OnUnitChanged" ValueExpression="() => form.UnitId" class="form-select">
                <option value="0">Select…</option>
                @foreach (var u in units)
                {
                    <option value="@u.Id">@u.DisplayName</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-2"><label class="form-label">Start</label><InputDate @bind-Value="form.StartDate" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">End (blank = month-to-month)</label><InputDate @bind-Value="form.EndDate" class="form-control" /></div>
        <div class="col-md-1"><label class="form-label">Rent</label><InputNumber @bind-Value="form.MonthlyRent" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">Deposit</label><InputNumber @bind-Value="form.SecurityDeposit" class="form-control" /></div>
        <div class="col-12">
            <label class="form-label">Tenants on this lease <span class="text-muted small">(check everyone who signed it)</span></label>
            <div class="border rounded p-2 d-flex flex-wrap gap-3" style="max-height: 10rem; overflow-y: auto">
                @foreach (var t in tenants)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="tenant-@t.Id" checked="@selectedTenantIds.Contains(t.Id)"
                               @onchange="e => ToggleTenant(t.Id, (bool)e.Value!)" />
                        <label class="form-check-label" for="tenant-@t.Id">@t.FullName</label>
                    </div>
                }
            </div>
        </div>
        <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Add lease</button></div>
    </EditForm>
    <FormError Message="@error" />
}

@code {
    private List<Lease> leases = [];
    private List<Unit> units = [];
    private List<Tenant> tenants = [];
    private Lease form = new();
    private HashSet<int> selectedTenantIds = [];
    private bool showEnded;
    private string? error;
    private DateOnly today;

    protected override async Task OnInitializedAsync()
    {
        today = DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);
        form = NewForm();
        await LoadAsync();
    }

    private Lease NewForm() => new() { StartDate = today };

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        leases = await db.Leases.AsNoTracking()
            .Include(l => l.Tenants)
            .Include(l => l.Unit).ThenInclude(u => u!.Property)
            .Include(l => l.Documents)
            .OrderByDescending(l => l.StartDate)
            .ToListAsync();
        units = await db.Units.AsNoTracking().Include(u => u.Property)
            .OrderBy(u => u.Property!.Name).ThenBy(u => u.Label)
            .ToListAsync();
        tenants = await db.Tenants.AsNoTracking().OrderBy(t => t.LastName).ThenBy(t => t.FirstName).ToListAsync();
    }

    private void OnUnitChanged(int unitId)
    {
        form.UnitId = unitId;
        // Default the lease rent to the unit's market rent.
        if (form.MonthlyRent == 0 && units.FirstOrDefault(u => u.Id == unitId) is { } unit)
        {
            form.MonthlyRent = unit.MarketRent;
        }
    }

    private void ToggleTenant(int tenantId, bool selected)
    {
        if (selected)
        {
            selectedTenantIds.Add(tenantId);
        }
        else
        {
            selectedTenantIds.Remove(tenantId);
        }
    }

    private async Task AddAsync()
    {
        error = Validate();
        if (error is not null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        form.Tenants = await db.Tenants.Where(t => selectedTenantIds.Contains(t.Id)).ToListAsync();
        db.Leases.Add(form);
        await db.SaveChangesAsync();
        Navigation.NavigateTo($"leases/{form.Id}");
    }

    private string? Validate()
    {
        if (form.UnitId == 0 || selectedTenantIds.Count == 0)
        {
            return "Select a unit and at least one tenant.";
        }
        if (form.EndDate is { } end && end < form.StartDate)
        {
            return "End date must be on or after the start date.";
        }
        if (form.MonthlyRent <= 0)
        {
            return "Rent must be greater than zero.";
        }

        var overlap = leases.FirstOrDefault(l => l.UnitId == form.UnitId
            && l.StartDate <= (form.EndDate ?? DateOnly.MaxValue)
            && (l.EndDate ?? DateOnly.MaxValue) >= form.StartDate);
        return overlap is null
            ? null
            : $"That unit already has a lease for {overlap.TenantNames} covering those dates. To add a roommate, open that lease and add them to it.";
    }

    private async Task EndLeaseAsync(int leaseId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var lease = await db.Leases.FindAsync(leaseId);
        if (lease is not null)
        {
            lease.EndDate = today;
            await db.SaveChangesAsync();
        }
        await LoadAsync();
    }
}

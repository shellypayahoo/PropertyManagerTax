@page "/"
@inject DashboardService Dashboard
@inject NavigationManager Navigation
@inject IOptionsMonitor<FeatureOptions> Features
@inject IReadOnlyList<PropertyManager.Web.Configuration.ConfigurationProblem> SettingsProblems

<PageTitle>Dashboard</PageTitle>

<h1>Dashboard</h1>

@if (SettingsProblems.Any(p => p.IsError))
{
    <div class="alert alert-warning" style="max-width: 60rem">
        <strong>Some settings in appsettings.json need fixing:</strong>
        <ul class="mb-0">
            @foreach (var problem in SettingsProblems.Where(p => p.IsError)) { <li>@problem.Message</li> }
        </ul>
    </div>
}

@if (summary is null)
{
    <p><em>Loading…</em></p>
}
else
{
    <div class="row g-3 mb-4">
        <StatCard Label="Properties" Value="@summary.PropertyCount.ToString()" />
        <StatCard Label="Rent paid this month" Value="@($"{summary.LeasesPaidThisMonth} / {summary.LeasesDueThisMonth}")" Href="rent" />
        <StatCard Label="Units occupied" Value="@($"{summary.OccupiedUnitCount} / {summary.UnitCount}")" />
        <StatCard Label="Monthly rent under lease" Value="@summary.MonthlyLeaseRent.ToString("C0")"
                  Detail="@($"Market rent: {summary.MonthlyMarketRent:C0}")" />
        <StatCard Label="Open maintenance" Value="@summary.OpenMaintenanceCount.ToString()" Href="maintenance"
                  Detail="@(summary.OpenLowPriorityMaintenanceCount > 0 ? $"+ {summary.OpenLowPriorityMaintenanceCount} low priority" : null)" />
        <StatCard Label="Expenses year to date" Value="@summary.ExpensesYearToDate.ToString("C0")" Href="expenses" />
    </div>

    @if (summary.OccupiedUnitCount == 0)
    {
        <div class="alert alert-info">
            No active leases yet. Add your <a href="tenants">tenants</a>, then create their <a href="leases">leases</a>
            to start tracking rent income.
        </div>
    }

    <MaintenanceReminders />
    @if (Features.CurrentValue.Calendar) { <UpcomingAppointments /> }
}

@code {
    private DashboardSummary? summary;

    protected override async Task OnInitializedAsync()
    {
        summary = await Dashboard.GetSummaryAsync();
        if (summary.PropertyCount == 0)
        {
            // A brand-new installation: walk the owner through setup first.
            Navigation.NavigateTo("setup");
        }
    }
}

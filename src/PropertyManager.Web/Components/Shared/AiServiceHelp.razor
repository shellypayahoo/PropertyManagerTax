@using PropertyManager.Core.Assistant
@* Step-by-step instructions for getting what an AI service needs (account, model, key), for someone who has never
   used one. Shown from the AI services section of Settings and from the setup wizard. Portal menus change, so each
   list also links to the provider's own guide. *@
@switch (Type)
{
    case AssistantProviderType.AzureFoundry:
        <ol class="small mb-2">
            <li>
                <strong>Get an Azure account</strong> (skip if you have one). Go to
                <a href="https://azure.microsoft.com/free" target="_blank" rel="noopener">azure.microsoft.com/free</a> and choose <strong>Try Azure for free</strong>.
                You sign in with a Microsoft account (a Hotmail or Outlook.com address works) and give a phone number and a credit or debit card
                (not a prepaid one). The card is to prove who you are: new accounts get a credit to try things, and after that you only pay for what you use.
            </li>
            <li>
                <strong>Open Microsoft Foundry.</strong> Go to <a href="https://ai.azure.com" target="_blank" rel="noopener">ai.azure.com</a> and sign in with the same account.
                The first time, it asks you to <strong>create a project</strong>: give it any name (for example "property-manager") and accept the suggested settings.
            </li>
            <li>
                <strong>Deploy a model.</strong> Open the <strong>model catalog</strong> (called <em>Discover</em> or <em>Model catalog</em>), pick an OpenAI
                "GPT" model (a <em>mini</em> one costs the least and is fine to start), and click <strong>Deploy</strong>. Accept the suggested settings.
                The <strong>deployment name</strong> it shows is what goes in <em>Deployment name</em> here.
            </li>
            <li>
                <strong>Copy the endpoint and key.</strong> Open your deployment (under <em>Build → Models</em>, or <em>Models + endpoints</em>). Its details show an
                <strong>endpoint</strong> (a web address ending in <code>azure.com/...</code>) and a <strong>key</strong> (a long string of letters and numbers).
                Copy each into the boxes here. Any of the endpoint addresses shown there works.
            </li>
            <li><strong>Click Test</strong> here. A ✓ means it's working; then click Save.</li>
        </ol>
        <p class="small text-muted mb-0">
            Cost: you pay Microsoft for what you use, typically a few cents per question with a mini model. Microsoft's own walkthrough, with pictures:
            <a href="https://learn.microsoft.com/azure/foundry/tutorials/quickstart-create-foundry-resources" target="_blank" rel="noopener">Create Foundry resources</a>.
            Treat the key like a password: paste it only here.
        </p>
        break;
    case AssistantProviderType.OpenAI:
        <ol class="small mb-2">
            <li>Go to <a href="https://platform.openai.com" target="_blank" rel="noopener">platform.openai.com</a> and sign up (this is separate from a ChatGPT subscription).</li>
            <li>Under <strong>Billing</strong>, add a payment method and a small amount of credit (the minimum is fine to start).</li>
            <li>Under <strong>API keys</strong>, click <strong>Create new secret key</strong> and copy it right away; it's only shown once. Paste it into <em>Key</em> here.</li>
            <li>For <em>Model</em>, type the name of a model from OpenAI's models page; a <em>mini</em> model costs the least.</li>
            <li><strong>Click Test</strong> here, then Save.</li>
        </ol>
        <p class="small text-muted mb-0">Cost: you pay OpenAI for what you use, typically a few cents per question. Treat the key like a password: paste it only here.</p>
        break;
    case AssistantProviderType.Anthropic:
        <ol class="small mb-2">
            <li>Go to <a href="https://console.anthropic.com" target="_blank" rel="noopener">console.anthropic.com</a> and sign up (this is separate from a Claude subscription).</li>
            <li>Under <strong>Billing</strong>, add a payment method and buy a small amount of credit.</li>
            <li>Under <strong>API keys</strong>, click <strong>Create key</strong> and copy it right away; it's only shown once. Paste it into <em>Key</em> here.</li>
            <li>Leave <em>Model</em> as it is, or type another Claude model name (<code>claude-haiku-5-5</code> costs the least).</li>
            <li><strong>Click Test</strong> here, then Save.</li>
        </ol>
        <p class="small text-muted mb-0">Cost: you pay Anthropic for what you use, typically a few cents per question. Treat the key like a password: paste it only here.</p>
        break;
    case AssistantProviderType.Ollama:
        <ol class="small mb-2">
            <li>Install <a href="https://ollama.com" target="_blank" rel="noopener">Ollama</a> on this computer and open it.</li>
            <li>In Ollama, download a model (for example <code>llama3.1</code>) and type its name in <em>Model</em> here.</li>
            <li><strong>Click Test</strong> here, then Save.</li>
        </ol>
        <p class="small text-muted mb-0">Free, and nothing leaves this computer, but it needs a recent computer with plenty of memory and answers are less reliable than the paid services.</p>
        break;
}

@code {
    [Parameter, EditorRequired] public AssistantProviderType Type { get; set; }
}

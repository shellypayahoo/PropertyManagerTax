@inject IDbContextFactory<PropertyManagerDbContext> DbFactory
@inject TimeProvider Clock
@inject IOptions<FeatureOptions> Features

@* Open Emergency, High, and Normal maintenance requests as reminders; Low priority is left on the Maintenance page. *@

@if (requests is not null)
{
    <h2 class="h5 mt-4">Open maintenance <span class="small text-muted fw-normal">(urgent and normal, by unit)</span></h2>
    <div class="row row-cols-1 row-cols-md-2 g-3 mb-2" style="max-width: 72rem">
        @foreach (var unit in units)
        {
            var open = requests.Where(r => r.UnitId == unit.Id).ToList();
            var border = open.Any(r => r.Priority == MaintenancePriority.Emergency) ? "border-danger"
                : open.Any(r => r.Priority == MaintenancePriority.High) ? "border-warning" : "";
            <div class="col">
                <div class="card h-100 @border @(border.Length > 0 ? "border-2" : "")">
                    <div class="card-header py-2 d-flex justify-content-between align-items-center">
                        <span class="fw-semibold d-flex align-items-center gap-2">
                            @if (Features.Value.PropertyPhotos && unit.Property?.PhotoKey is not null)
                            {
                                <img src="properties/@unit.PropertyId/photo" alt="" class="rounded" style="width: 40px; height: 30px; object-fit: cover" />
                            }
                            @unit.Property?.Name · Unit @unit.Label
                        </span>
                        @if (open.Count > 0) { <span class="badge text-bg-light border">@open.Count open</span> }
                    </div>
                    <div class="card-body py-2">
                        @if (open.Count == 0)
                        {
                            <span class="text-success">✓ All clear</span>
                        }
                        @foreach (var m in open)
                        {
                            var age = today.DayNumber - m.ReportedOn.DayNumber;
                            <div class="mb-2">
                                <span class="badge @Badge(m.Priority) me-1">@m.Priority</span>
                                <a href="maintenance">@m.Title</a>
                                <div class="small text-muted ms-1">
                                    @if (m.ScheduledFor is { } when)
                                    {
                                        <span class="@(when < today ? "text-danger" : "")">@when.ToString("ddd, MMM d")@(when < today ? " (passed)" : "")</span>
                                    }
                                    else
                                    {
                                        <span>Not scheduled</span>
                                    }
                                    · @(m.Vendor?.Name ?? "No vendor yet")
                                    · <span class="@(age > 14 ? "text-danger" : "")">@(age switch { <= 0 => "reported today", 1 => "reported yesterday", _ => $"reported {age} days ago" })</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<MaintenanceRequest>? requests;
    private List<Unit> units = [];
    private DateOnly today;

    protected override async Task OnInitializedAsync()
    {
        today = DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);
        await using var db = await DbFactory.CreateDbContextAsync();
        units = await db.Units.AsNoTracking().Include(u => u.Property).OrderBy(u => u.Property!.Name).ThenBy(u => u.Label).ToListAsync();
        requests = (await db.MaintenanceRequests.AsNoTracking()
                .Include(m => m.Unit).ThenInclude(u => u!.Property)
                .Include(m => m.Vendor)
                .Where(m => m.Status != MaintenanceStatus.Completed && m.Status != MaintenanceStatus.Cancelled
                    && m.Priority != MaintenancePriority.Low)
                .ToListAsync())
            .OrderByDescending(m => m.Priority)
            .ThenBy(m => m.ReportedOn)
            .ToList();
    }

    private static string Badge(MaintenancePriority p) => p switch
    {
        MaintenancePriority.Emergency => "text-bg-danger",
        MaintenancePriority.High => "text-bg-warning",
        _ => "text-bg-secondary",
    };
}

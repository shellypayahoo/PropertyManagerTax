@inject IDbContextFactory<PropertyManagerDbContext> DbFactory
@inject TimeProvider Clock

<div class="d-flex flex-wrap gap-2 align-items-end py-1">
    <div>
        <label class="form-label small mb-0">Received on</label>
        <input type="date" class="form-control form-control-sm" @bind="date" @bind:after="ClearWarning" />
    </div>
    <div style="width: 8rem">
        <label class="form-label small mb-0">Amount</label>
        <input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="amount" @bind:after="ClearWarning" />
    </div>
    <div>
        <label class="form-label small mb-0">How</label>
        <select class="form-select form-select-sm" @bind="method">
            @foreach (var m in Enum.GetValues<PaymentMethod>()) { <option value="@m">@m</option> }
        </select>
    </div>
    <div class="flex-grow-1" style="min-width: 8rem">
        <label class="form-label small mb-0">Notes</label>
        <input class="form-control form-control-sm" @bind="notes" placeholder="Optional" />
    </div>
    @if (warning is null)
    {
        <button class="btn btn-sm btn-success" @onclick="() => SaveAsync(confirmed: false)">Save</button>
    }
    <button class="btn btn-sm btn-link" @onclick="OnCancel">Cancel</button>
</div>
<FormError Message="@error" />
@if (warning is not null)
{
    <div class="alert alert-warning py-2 mb-1 d-flex flex-wrap gap-2 align-items-center">
        <span><strong>Looks like a double entry.</strong> @warning</span>
        <button class="btn btn-sm btn-outline-dark ms-auto" @onclick="() => SaveAsync(confirmed: true)">Save anyway</button>
        <button class="btn btn-sm btn-dark" @onclick="OnCancel">Don't save</button>
    </div>
}

@code {
    /// <summary>Records a rent payment toward <see cref="Month"/> on <see cref="LeaseId"/>.</summary>
    [Parameter, EditorRequired] public int LeaseId { get; set; }
    [Parameter, EditorRequired] public DateOnly Month { get; set; }
    [Parameter] public decimal Amount { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private DateOnly date;
    private decimal amount;
    private PaymentMethod method = PaymentMethod.Zelle;
    private string? notes;
    private string? error;
    private string? warning;

    protected override void OnInitialized()
    {
        var today = DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);
        // For a past month default to its 1st; otherwise today.
        date = Month.AddMonths(1) <= today ? Month : today;
        amount = Amount;
    }

    private void ClearWarning() => warning = null;

    private async Task SaveAsync(bool confirmed)
    {
        if (amount <= 0)
        {
            error = "Amount must be greater than zero.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        if (!confirmed)
        {
            var lease = await db.Leases.AsNoTracking().Include(l => l.Payments).SingleAsync(l => l.Id == LeaseId);
            warning = RentSchedule.CheckNewPayment(lease, Month, date, amount, DateOnly.FromDateTime(Clock.GetLocalNow().DateTime));
            if (warning is not null)
            {
                return;
            }
        }

        db.RentPayments.Add(new RentPayment
        {
            LeaseId = LeaseId,
            ForMonth = Month,
            Date = date,
            Amount = amount,
            Method = method,
            Notes = string.IsNullOrWhiteSpace(notes) ? null : notes.Trim(),
        });
        await db.SaveChangesAsync();
        await OnSaved.InvokeAsync();
    }
}

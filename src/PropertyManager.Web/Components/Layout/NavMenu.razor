@inject IOptionsMonitor<FeatureOptions> Features
@inject IOptionsMonitor<BusinessOptions> Business

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@(string.IsNullOrWhiteSpace(Business.CurrentValue.Name) ? "Property Manager" : Business.CurrentValue.Name)</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @foreach (var (heading, links) in Groups)
        {
            var shown = links.Where(l => IsOn(l.Href)).ToList();
            if (shown.Count == 0)
            {
                continue;
            }
            @if (heading is null && links != Groups[0].Links)
            {
                <div class="nav-section-gap" aria-hidden="true"></div>
            }
            else if (heading is not null)
            {
                <div class="nav-group">@heading</div>
            }
            @foreach (var (href, label, icon) in shown)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@href" Match="@(href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                        <span class="bi bi-@icon-nav-menu" aria-hidden="true"></span> @LabelFor(href, label)
                    </NavLink>
                </div>
            }
        }
    </nav>
</div>

@code {
    // Pages for parts of the app turned off in "Features" are left out of the menu.
    private bool IsOn(string href) => href switch
    {
        "messages" => Features.CurrentValue.TextMessages,
        "email" => Features.CurrentValue.Email || Features.CurrentValue.Calendar,
        "ask" => Features.CurrentValue.Assistant,
        _ => true,
    };

    private string LabelFor(string href, string label) => href != "email" ? label
        : Features.CurrentValue.Email && Features.CurrentValue.Calendar ? label : Features.CurrentValue.Email ? "Email" : "Calendar";

    // The menu in groups; a group whose pages are all turned off isn't shown. A null heading is just a gap.
    private static readonly (string? Heading, (string Href, string Label, string Icon)[] Links)[] Groups =
    [
        (null, [("", "Dashboard", "house-door"), ("ask", "Ask", "chat-dots")]),
        ("Money", [("rent", "Rent", "cash-coin"), ("expenses", "Expenses", "receipt"), ("reports", "Reports", "bar-chart-line"), ("import", "Import", "box-arrow-in-down")]),
        ("Properties", [("properties", "Properties", "buildings"), ("tenants", "Tenants", "people"), ("leases", "Leases", "file-earmark-text"),
            ("maintenance", "Maintenance", "tools"), ("vendors", "Vendors", "person-badge")]),
        ("Inbox", [("messages", "Messages", "chat-left-text"), ("email", "Email & calendar", "envelope")]),
        (null, [("documents", "Documents", "folder2-open"), ("settings", "Settings", "gear")]),
    ];
}

@inject IOptionsMonitor<FeatureOptions> Features
@inject IOptionsMonitor<BusinessOptions> Business

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@(string.IsNullOrWhiteSpace(Business.CurrentValue.Name) ? "Property Manager" : Business.CurrentValue.Name)</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @foreach (var (href, label, icon) in Links.Where(l => IsOn(l.Href)))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@href" Match="@(href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                    <span class="bi @icon" aria-hidden="true"></span> @LabelFor(href, label)
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    // Pages for parts of the app turned off in "Features" are left out of the menu.
    private bool IsOn(string href) => href switch
    {
        "messages" => Features.CurrentValue.TextMessages,
        "email" => Features.CurrentValue.Email || Features.CurrentValue.Calendar,
        "ask" => Features.CurrentValue.Assistant,
        _ => true,
    };

    private string LabelFor(string href, string label) => href != "email" ? label
        : Features.CurrentValue.Email && Features.CurrentValue.Calendar ? label : Features.CurrentValue.Email ? "Email" : "Calendar";

    private static readonly (string Href, string Label, string Icon)[] Links =
    [
        ("", "Dashboard", "bi-house-door-fill-nav-menu"),
        ("properties", "Properties", "bi-list-nested-nav-menu"),
        ("tenants", "Tenants", "bi-list-nested-nav-menu"),
        ("leases", "Leases", "bi-list-nested-nav-menu"),
        ("rent", "Rent", "bi-plus-square-fill-nav-menu"),
        ("expenses", "Expenses", "bi-plus-square-fill-nav-menu"),
        ("maintenance", "Maintenance", "bi-plus-square-fill-nav-menu"),
        ("vendors", "Vendors", "bi-list-nested-nav-menu"),
        ("import", "Import", "bi-plus-square-fill-nav-menu"),
        ("messages", "Messages", "bi-list-nested-nav-menu"),
        ("email", "Email & calendar", "bi-list-nested-nav-menu"),
        ("ask", "Ask", "bi-list-nested-nav-menu"),
        ("reports", "Reports", "bi-list-nested-nav-menu"),
        ("settings", "Settings", "bi-list-nested-nav-menu"),
    ];
}

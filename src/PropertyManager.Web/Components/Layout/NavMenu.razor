<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Property Manager</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @foreach (var (href, label, icon) in Links)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@href" Match="@(href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                    <span class="bi @icon" aria-hidden="true"></span> @label
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private static readonly (string Href, string Label, string Icon)[] Links =
    [
        ("", "Dashboard", "bi-house-door-fill-nav-menu"),
        ("properties", "Properties", "bi-list-nested-nav-menu"),
        ("tenants", "Tenants", "bi-list-nested-nav-menu"),
        ("leases", "Leases", "bi-list-nested-nav-menu"),
        ("rent", "Rent", "bi-plus-square-fill-nav-menu"),
        ("expenses", "Expenses", "bi-plus-square-fill-nav-menu"),
        ("maintenance", "Maintenance", "bi-plus-square-fill-nav-menu"),
        ("vendors", "Vendors", "bi-list-nested-nav-menu"),
        ("import", "Import", "bi-plus-square-fill-nav-menu"),
        ("reports", "Reports", "bi-list-nested-nav-menu"),
    ];
}

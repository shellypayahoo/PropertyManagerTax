{
  "ConnectionStrings": {
    "PropertyManager": "Data Source=propertymanager.db"
  },
  "DocumentStorage": {
    "LocalPath": "App_Data/documents"
  },
  "Setup": {
    "Properties": [
      {
        "Name": "2228 1st St NW",
        "Units": [
          { "Label": "A", "MarketRent": 4400 },
          { "Label": "B", "MarketRent": 4500 }
        ]
      },
      {
        "Name": "1354 Taylor St NW",
        "Units": [
          { "Label": "A", "MarketRent": 4500 },
          { "Label": "B", "MarketRent": 1000 }
        ]
      }
    ]
  },
  "Email": {
    "ClientId": "",
    "Tenant": "consumers"
  },
  "Assistant": {
    "Providers": {
      "Claude": {
        "Type": "Anthropic",
        "Model": "claude-opus-5-5"
      },
      "AzureFoundry": {
        "Type": "AzureFoundry",
        "Model": "<deployment-name>",
        "Endpoint": "https://<your-resource>.openai.azure.com/openai/v1/"
      },
      "ClaudeOnFoundry": {
        "Type": "AnthropicFoundry",
        "Model": "claude-opus-5-5",
        "Resource": "<your-resource>"
      },
      "Ollama": {
        "Type": "Ollama",
        "Model": "llama3.1",
        "Endpoint": "http://localhost:11434"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

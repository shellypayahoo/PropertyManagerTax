{
  // Settings for a new owner's installation. The owner sets the business, properties, and features in the app
  // (first-run setup and Settings). Keys go in appsettings.Local.json next to this file, never here.
  "ConnectionStrings": {
    "PropertyManager": "Data Source=propertymanager.db"
  },
  "DocumentStorage": {
    "LocalPath": "App_Data/documents"
  },
  "Features": {
    "TextMessages": false,
    "Email": false,
    "Calendar": false,
    "Assistant": false
  },
  "Email": {
    "ClientId": "",
    "Tenant": "consumers"
  },
  "Assistant": {
    "Providers": {
      "AzureFoundry": {
        "Type": "AzureFoundry",
        "Model": "<deployment-name>",
        "Endpoint": "https://<your-resource>.cognitiveservices.azure.com/openai/v1/"
      },
      "OpenAI": {
        "Type": "OpenAI",
        "Model": "gpt-5-mini"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

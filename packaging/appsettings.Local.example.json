{
  // Copy to appsettings.Local.json (next to PropertyManager.Web.exe) and fill in what this owner uses.
  // This file holds secrets: keep it on their computer only.

  // An Azure AI Foundry deployment (or delete this and use OpenAI below).
  "Assistant": {
    "DefaultProvider": "AzureFoundry",
    "Providers": {
      "AzureFoundry": {
        "Model": "<deployment name>",
        "Endpoint": "https://<resource>.cognitiveservices.azure.com/openai/v1/",
        "ApiKey": "<key>"
      },
      "OpenAI": {
        "ApiKey": "<OpenAI API key>"
      }
    }
  },

  // Outlook.com / Hotmail email and calendar: the Application (client) ID of an app registration.
  "Email": {
    "ClientId": "<Application (client) ID>"
  }

  // Then turn on Email, Calendar, or Ask on the Settings page in the app.
}

{
  // Example settings for a new installation. Copy the parts you need into
  // src/PropertyManager.Web/appsettings.json. Keys and other secrets don't go here:
  // set them with `dotnet user-secrets` or environment variables (see "Configuration" in the README).

  "Business": {
    "Name": "Maple Street Rentals LLC",   // shown in the menu and on the P&L PDF
    "RentDueDay": 1,                      // 1–28
    "LateAfterDays": 5,                   // the Rent collection report's starting grace period
    "TimeZone": "America/New_York"        // optional; blank uses the computer's time zone
  },

  // Everything is on unless turned off here.
  "Features": {
    "TextMessages": false,                // import texts from the Mac's Messages app (macOS only)
    "Email": true,                        // sync tenant emails from Outlook.com / Hotmail
    "Calendar": true,                     // sync Outlook.com calendars
    "Assistant": true,                    // the Ask page
    "Receipts": true,                     // receipts on expenses
    "PropertyPhotos": true                // a photo for each property
  },

  // Created when the app starts with an empty database; ignored once there are properties.
  "Setup": {
    "Properties": [
      {
        "Name": "12 Maple Ave",
        "City": "Silver Spring",
        "State": "MD",
        "PostalCode": "20910",
        "Units": [
          { "Label": "1", "MarketRent": 2100 },
          { "Label": "2", "MarketRent": 2000 }
        ]
      }
    ]
  },

  "Assistant": {
    "DefaultProvider": "OpenAI",          // the Ask page starts here; empty = first one that's set up
    "AllowPhotos": true,
    "Providers": {
      "OpenAI":       { "Type": "OpenAI", "Model": "gpt-5-mini" },
      "AzureFoundry": { "Type": "AzureFoundry", "Model": "<deployment name>", "Endpoint": "https://<resource>.cognitiveservices.azure.com/openai/v1/" },
      "Claude":       { "Type": "Anthropic", "Model": "claude-opus-5-5" },
      "Local":        { "Type": "Ollama", "Model": "llama3.1", "Endpoint": "http://localhost:11434" }
    }
  },

  "Email": {
    "ClientId": "<Application (client) ID of your app registration>",
    "Tenant": "consumers",
    "MyAddresses": []
  },

  "ConnectionStrings": { "PropertyManager": "Data Source=propertymanager.db" },
  "DocumentStorage": { "LocalPath": "App_Data/documents" }
}
